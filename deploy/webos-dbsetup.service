[Unit]
Description=WebOS database network setup for the DbGate sidecar
After=postgresql.service mariadb.service
Wants=postgresql.service mariadb.service

[Service]
Type=oneshot
EnvironmentFile=-/opt/webos/.env
ExecStart=/usr/local/bin/webos-dbsetup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
