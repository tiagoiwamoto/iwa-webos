#!/bin/bash
# Runs once after postgresql/mariadb come up: opens both engines to the
# docker network so the DbGate sidecar can reach them, and creates the
# credentials that docker-compose injects into DbGate.
# Idempotent — safe on every boot.
set -u

DB_PASS="${WEBOS_DB_PASSWORD:-${WEBOS_PASSWORD:-webos}}"

# --- PostgreSQL: listen on all interfaces + password auth from the LAN ----
for conf in /etc/postgresql/*/main/postgresql.conf; do
  [ -f "$conf" ] || continue
  sed -i -E "s/^#?\s*listen_addresses\s*=.*/listen_addresses = '*'/" "$conf"
done
for hba in /etc/postgresql/*/main/pg_hba.conf; do
  [ -f "$hba" ] || continue
  # match an uncommented rule only — the stock file mentions samenet
  # in a comment
  grep -qE '^[^#]*samenet' "$hba" \
    || echo 'host all all samenet scram-sha-256' >> "$hba"
done

for i in $(seq 1 30); do
  pg_isready -q 2>/dev/null && break
  sleep 2
done
if pg_isready -q 2>/dev/null; then
  systemctl restart postgresql || true
  for i in $(seq 1 15); do pg_isready -q && break; sleep 2; done
  runuser -u postgres -- psql -qc \
    "ALTER USER postgres PASSWORD '${DB_PASS}'" || true
fi

# --- MariaDB: bind on all interfaces + dedicated webos user ---------------
for cnf in /etc/mysql/mariadb.conf.d/50-server.cnf /etc/mysql/my.cnf; do
  [ -f "$cnf" ] || continue
  grep -q '^bind-address' "$cnf" \
    && sed -i -E 's/^bind-address\s*=.*/bind-address = 0.0.0.0/' "$cnf"
done

if systemctl is-enabled mariadb.service >/dev/null 2>&1 \
   || systemctl is-active mariadb.service >/dev/null 2>&1; then
  systemctl restart mariadb || true
  for i in $(seq 1 30); do
    mariadb-admin --silent ping 2>/dev/null && break
    sleep 2
  done
  mariadb -e "
    CREATE USER IF NOT EXISTS 'webos'@'%' IDENTIFIED BY '${DB_PASS}';
    ALTER USER 'webos'@'%' IDENTIFIED BY '${DB_PASS}';
    GRANT ALL PRIVILEGES ON *.* TO 'webos'@'%';
    FLUSH PRIVILEGES;" || true
fi
